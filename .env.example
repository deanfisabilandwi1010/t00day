# Salin ke .env.local (lokal) atau isi di Netlify → Site configuration → Environment variables.
# Jangan pernah commit nilai asli.

# --- Server saja (RAHASIA, tanpa prefix NEXT_PUBLIC) ---
# Connection string Postgres. Supabase: Project Settings → Database → Connection string →
# "Transaction pooler" (port 6543), contoh:
# postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Lokal (npm run db:local): postgres://postgres:postgres@127.0.0.1:54329/tooday
DATABASE_URL=
# Jumlah koneksi per instance server (opsional, default 5).
DATABASE_POOL_MAX=5
# Origin tambahan yang boleh melakukan POST/PATCH, dipisah koma (opsional). Default: hanya host situs ini.
ALLOWED_ORIGINS=

# --- Publik (boleh terlihat di browser) ---
# Domain final situs; dipakai untuk membangun URL QR.
NEXT_PUBLIC_SITE_URL=https://toodaycoffe.netlify.app
# Slug outlet bawaan bila QR tidak membawa ?outlet=
NEXT_PUBLIC_DEFAULT_OUTLET=tooday-main
# Opsional: nudge Supabase Realtime (hanya angka versi, tanpa data pesanan). Kosongkan = polling saja.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
