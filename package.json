{
  "name": "tooday-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/db/local.mjs start",
    "db:local:stop": "node scripts/db/local.mjs stop",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db/migrate.mjs",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/db/seed.mjs",
    "staff:create": "node --env-file-if-exists=.env.local scripts/staff-create.mjs",
    "test:api": "node --env-file-if-exists=.env.local --test --test-concurrency=1 tests/order-system.test.mjs",
    "qa:order": "node --env-file-if-exists=.env.local scripts/qa-order-flow.mjs docs/order-system/screenshots",
    "qr": "node --env-file-if-exists=.env.local scripts/qr-generate.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
